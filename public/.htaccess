Options -Indexes
DirectoryIndex disabled
DirectorySlash Off

<IfModule mod_headers.c>
  Header set X-Htaccess-Active "yes"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Force /resources and /resources/ to the SPA (must run before -d check)
  RewriteRule ^resources/?$ /index.html [L]

  # If a request maps to a real directory (e.g. /resources/), serve the SPA
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ /index.html [L]

  # Otherwise, fall back to SPA for any non-existent file
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule . /index.html [L]
</IfModule>
